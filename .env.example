# Copiez ce fichier en .env.local

# Style MapLibre des cartes (commerces). Par défaut : CARTO Dark Matter.
# Exemple MapTiler : https://api.maptiler.com/maps/<id-du-style>/style.json?key=<clé>
NEXT_PUBLIC_MAP_STYLE_URL=

# Optionnel : affiche les commerces de Google (Places API "New") au lieu d'OpenStreetMap.
# Créez une clé sur https://console.cloud.google.com/ (API "Places API (New)").
GOOGLE_PLACES_API_KEY=

# Optionnel : index du web entier (dizaines de milliards de pages) via l'API Brave Search.
# Offre gratuite sur https://brave.com/search/api/ - les résultats sont fusionnés avec l'index Googlant.
BRAVE_SEARCH_API_KEY=

# Géolocalisation IP quand l'hébergeur ne fournit pas la ville :
#   (vide) = seulement en local / 1 = aussi pour les visiteurs (IP envoyée à ipwho.is) / 0 = jamais
GEOIP_LOOKUP=

# --- Site sur Vercel relié au serveur d'index (chez soi, exposé par Tailscale Funnel)
# Adresse du serveur d'index et jeton partagé (même valeur dans le .env.local du serveur)
GOOGLANT_INDEX_URL=
GOOGLANT_INDEX_TOKEN=
# Chiffres en direct : les navigateurs se connectent directement au serveur d'index
# (flux /api/live/stream), Vercel ne sert aucune de ces requêtes. Ex. https://monserveur.ts.net
NEXT_PUBLIC_LIVE_URL=
# Adresse publique du site (robots.txt, sitemap.xml). Sur Vercel, déduite automatiquement.
NEXT_PUBLIC_SITE_URL=
# Jeton Google Search Console (balise google-site-verification) pour faire indexer le site par Google
GOOGLE_SITE_VERIFICATION=

# Aperçu IA en haut des résultats : clé gratuite sur https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optionnel : modèle(s) à utiliser, séparés par des virgules (par défaut gemini-flash-latest, puis gemini-2.5-flash)
GEMINI_MODEL=
